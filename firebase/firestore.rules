rules_version = '2';

// 鍾家大宅 App 的 Firestore 安全規則
// 用法：Firebase 後台 → Firestore Database → 規則 → 整份貼上 → 發布
//
// 只有 UID 出現在 members 集合裡的帳號才能讀寫，
// 其他人即使登入也什麼都看不到。

service cloud.firestore {
  match /databases/{database}/documents {

    function isFamily() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function isAdmin() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('admin', false) == true;
    }

    // 小朋友 = members 文件裡 child: true 的成員；其他人都算家長
    function isChild() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('child', false) == true;
    }

    function validLedger() {
      let d = request.resource.data;
      return d.kid is string
        && exists(/databases/$(database)/documents/members/$(d.kid))
        && d.type in ['income', 'expense']
        && d.amount is number && d.amount >= 1 && d.amount <= 1000000
        && d.note is string && d.note.size() <= 100
        && d.date is string
        && d.get('by_parent', false) is bool;
    }

    function validScore() {
      let d = request.resource.data;
      return d.kid is string
        && exists(/databases/$(database)/documents/members/$(d.kid))
        && d.subject is string && d.subject.size() >= 1 && d.subject.size() <= 12
        && d.title is string && d.title.size() <= 40
        && d.date is string
        && d.full is number && d.full >= 1 && d.full <= 1000
        && d.score is number && d.score >= 0 && d.score <= d.full;
    }

    // 投票還能投嗎：沒被手動結束，而且沒過截止時間（deadline_at 是 0 或沒有，代表沒設截止日）
    // 日期比大小用：今天的台灣日期、'YYYY-MM-DD' 字串，都換成 20261119 這樣的數字
    function todayNum() {
      let t = request.time + duration.value(8, 'h');
      return t.year() * 10000 + t.month() * 100 + t.day();
    }
    function dateNum(s) {
      return int(s[0:4]) * 10000 + int(s[5:7]) * 100 + int(s[8:10]);
    }

    function pollOpen(pollId) {
      let p = get(/databases/$(database)/documents/polls/$(pollId)).data;
      return p.closed == false && p.get('voided', false) == false
        && (p.get('deadline_at', 0) == 0 || request.time.toMillis() <= p.get('deadline_at', 0));
    }

    function validRequest() {
      let d = request.resource.data;
      return d.kid is string
        && exists(/databases/$(database)/documents/members/$(d.kid))
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 100
        && d.amount is number && d.amount >= 1 && d.amount <= 1000000
        && d.need_date is string
        && d.status in ['pending', 'given'];
    }

    // 小朋友只能動「自己提出、家長還沒給」的申請
    function ownPending(d) {
      return d.kid == request.auth.uid && d.status == 'pending';
    }

    // 小朋友只能動「自己的支出」
    function ownExpense(d) {
      // 父母支出（by_parent）只有家長能記、能改
      return d.kid == request.auth.uid && d.type == 'expense' && d.get('by_parent', false) == false;
    }

    function ownsEvent() {
      return resource.data.get('created_by', request.auth.uid) == request.auth.uid;
    }

    function validEvent() {
      let d = request.resource.data;
      return d.title is string && d.title.size() >= 1 && d.title.size() <= 80
        && d.category is string && d.category.size() >= 1 && d.category.size() <= 40
        && d.event_date is string && d.end_date is string
        && d.end_date >= d.event_date
        && d.member_ids is list;
    }

    function validNote() {
      let d = request.resource.data;
      return d.title is string && d.title.size() <= 100
        && d.body is string && d.body.size() <= 20000
        && d.pinned is bool;
    }

    function validContact() {
      let d = request.resource.data;
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.phone is string && d.phone.size() <= 30;
    }

    // 訊息：一般是文字；如果是照片，文字可以是空的，但要有 image_id 和小縮圖
    function validMessage() {
      let d = request.resource.data;
      return d.text is string && d.text.size() <= 2000
        && (d.text.size() >= 1
            || (d.get('image_id', '') is string && d.get('image_id', '').size() >= 1
                && d.get('thumb', '') is string && d.get('thumb', '').size() <= 60000))
        && d.sender == request.auth.uid
        && d.sent_at is number
        // @某人、引用回覆（都可以沒有）
        && d.get('mentions', []) is list && d.get('mentions', []).size() <= 10
        && d.get('reply_to', {}) is map;
    }

    function validPost() {
      let d = request.resource.data;
      return d.text is string && d.text.size() >= 1 && d.text.size() <= 2000
        && d.author == request.auth.uid
        && d.to is list && d.to.size() >= 1 && d.to.size() <= 10
        && d.created_at is number;
    }

    // 回覆：必須是被那則發言標註的人
    function validReply() {
      let d = request.resource.data;
      return d.text is string && d.text.size() >= 1 && d.text.size() <= 2000
        && d.author == request.auth.uid
        && d.post_id is string
        && d.created_at is number
        && request.auth.uid in get(/databases/$(database)/documents/posts/$(d.post_id)).data.to;
    }

    // 收回訊息：只能收回自己的、送出一小時內的，而且只能清空內容
    function validRecall() {
      return resource.data.sender == request.auth.uid
        && request.time.toMillis() - resource.data.sent_at < 3600000
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'recalled', 'thumb', 'image_id'])
        && request.resource.data.recalled == true
        && request.resource.data.text == '';
    }

    // 成員名單：在 Firebase 後台維護。唯一的例外是管理員可以在 App 裡切換「是不是小朋友」。
    match /members/{uid} {
      allow read: if isFamily();
      allow update: if isFamily() && isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['child'])
        && request.resource.data.child is bool;
      allow create, delete: if false;
    }

    // 零用錢記帳本：家長可以看、可以改全部；
    // 小朋友只看得到自己的，只能新增、修改、刪除自己的支出（不能自己加零用錢）
    match /ledger/{id} {
      allow read: if isFamily() && (!isChild() || resource.data.kid == request.auth.uid);
      allow create: if isFamily() && validLedger()
        && (!isChild() || ownExpense(request.resource.data));
      allow update: if isFamily() && validLedger()
        && (!isChild() || (ownExpense(resource.data) && ownExpense(request.resource.data)));
      allow delete: if isFamily()
        && (!isChild() || ownExpense(resource.data));
    }

    // 行事曆：全家都看得到，但只有新增的人可以修改或刪除。
    // （沒有記錄新增者的舊行程不限制；修改時不能把新增者換成別人）
    match /events/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && validEvent()
        && request.resource.data.get('created_by', request.auth.uid) == request.auth.uid;
      allow update: if isFamily() && validEvent() && ownsEvent()
        && request.resource.data.get('created_by', null) == resource.data.get('created_by', null);
      allow delete: if isFamily() && ownsEvent();
    }

    // 雜記
    match /notes/{id} {
      allow read, delete: if isFamily();
      allow create, update: if isFamily() && validNote();
    }

    // 通訊錄（App 已不再使用，保留規則讓舊資料還讀得到）
    match /contacts/{id} {
      allow read, delete: if isFamily();
      allow create, update: if isFamily() && validContact();
    }

    // 自訂的行事曆類型：全家都看得到，只有家長可以新增、修改、刪除
    match /categories/{id} {
      allow read: if isFamily();
      allow create, update: if isFamily() && !isChild()
        && request.resource.data.label is string
        && request.resource.data.label.size() >= 1 && request.resource.data.label.size() <= 12
        && request.resource.data.color is string
        && request.resource.data.color.matches('^#[0-9A-Fa-f]{6}$');
      allow delete: if isFamily() && !isChild();
    }

    // 考試科目：全家都看得到，只有家長可以新增或刪除
    match /subjects/{id} {
      allow read: if isFamily();
      allow create, update: if isFamily() && !isChild()
        && request.resource.data.label is string
        && request.resource.data.label.size() >= 1 && request.resource.data.label.size() <= 12;
      allow delete: if isFamily() && !isChild();
    }

    // 費用申請：小朋友提出自己的申請，只有家長能標示「已給」
    match /requests/{id} {
      allow read: if isFamily() && (!isChild() || resource.data.kid == request.auth.uid);
      allow create: if isFamily() && validRequest()
        && (!isChild() || ownPending(request.resource.data));
      allow update: if isFamily() && validRequest()
        && (!isChild() || (ownPending(resource.data) && ownPending(request.resource.data)));
      // 過了「哪一天需要」就不能再刪除（家長也一樣），紀錄會留著
      allow delete: if isFamily()
        && (!isChild() || ownPending(resource.data))
        && dateNum(resource.data.need_date) >= todayNum();
    }

    // 聊天室：只能以自己的名義發言；一小時內可以收回，不能刪除
    match /messages/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && validMessage();
      allow update: if isFamily() && validRecall();
      allow delete: if false;
    }

    // 聊天照片的原圖：只能以自己的名義上傳；收回訊息時由本人刪除
    match /chat_images/{id} {
      allow read: if isFamily();
      allow create: if isFamily()
        && request.resource.data.sender == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 950000;
      allow delete: if isFamily() && (resource.data.sender == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // 考試成績：小朋友只看得到、只能改自己的；家長看得到全部，也可以幫忙登記
    match /scores/{id} {
      allow read: if isFamily() && (!isChild() || resource.data.kid == request.auth.uid);
      allow create: if isFamily() && validScore()
        && (!isChild() || request.resource.data.kid == request.auth.uid);
      allow update: if isFamily() && validScore()
        && (!isChild() || (resource.data.kid == request.auth.uid && request.resource.data.kid == request.auth.uid));
      allow delete: if isFamily()
        && (!isChild() || resource.data.kid == request.auth.uid);
    }

    // 家庭旅遊：全家都可以新增、修改旅程，以及底下的行程、日誌、行李、花費。
    // 刪除整趟旅程、刪除日誌：只有建立的人和管理員可以；日誌也只有寫的人和管理員能改。
    function validTrip() {
      let d = request.resource.data;
      return d.title is string && d.title.size() >= 1 && d.title.size() <= 40
        && d.start_date is string && d.end_date is string && d.end_date >= d.start_date;
    }
    function validTripItem() {
      let d = request.resource.data;
      return d.trip_id is string
        && d.kind in ['plan', 'journal', 'pack', 'cost']
        && d.get('text', '') is string && d.get('text', '').size() <= 3000
        && d.get('thumb', '') is string && d.get('thumb', '').size() <= 200000;
    }
    function madeIt() {
      return resource.data.get('created_by', null) == request.auth.uid;
    }
    // 這一筆所屬的旅程是不是自己建立的（刪除整趟旅程時，要能一併刪掉別人寫的日誌）
    function madeTripOf(item) {
      return exists(/databases/$(database)/documents/trips/$(item.trip_id))
        && get(/databases/$(database)/documents/trips/$(item.trip_id)).data.get('created_by', null) == request.auth.uid;
    }
    match /trips/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && validTrip()
        && request.resource.data.get('created_by', request.auth.uid) == request.auth.uid;
      allow update: if isFamily() && validTrip()
        && request.resource.data.get('created_by', null) == resource.data.get('created_by', null);
      allow delete: if isFamily() && (madeIt() || isAdmin());
    }
    // 生日卡片：每人每年給每位壽星一張（文件 id 是「壽星UID_年份_自己的UID」），只能寫、改、刪自己的；不能寫給自己
    match /birthday_cards/{id} {
      // 內容只有寫的人和壽星看得到
      allow read: if isFamily() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create, update: if isFamily()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.year is int
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 300
        && request.resource.data.sticker is string && request.resource.data.sticker.size() <= 8
        && id == request.resource.data.to + '_' + string(request.resource.data.year) + '_' + request.auth.uid;
      allow delete: if isFamily() && (resource.data.from == request.auth.uid || isAdmin());
    }

    // 旅遊日誌的表情回應：每個人每則一個（文件 id 是「日誌id_自己的UID」），只能加、換、收回自己的
    match /journal_reacts/{id} {
      allow read: if isFamily();
      allow create, update: if isFamily()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.item_id is string && request.resource.data.trip_id is string
        && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 8
        && id == request.resource.data.item_id + '_' + request.auth.uid;
      allow delete: if isFamily() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    match /trip_items/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && validTripItem()
        && request.resource.data.get('created_by', request.auth.uid) == request.auth.uid;
      allow update: if isFamily() && validTripItem()
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.get('created_by', null) == resource.data.get('created_by', null)
        && (resource.data.kind != 'journal' || madeIt() || isAdmin());
      allow delete: if isFamily()
        && (resource.data.kind != 'journal' || madeIt() || isAdmin() || madeTripOf(resource.data));
    }

    // 家庭相簿：全家都能看、能放照片、留言、按愛心；照片只有放的人和管理員可以修改資訊和刪除
    match /photos/{id} {
      allow read: if isFamily();
      allow create: if isFamily()
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.author == request.auth.uid
        && request.resource.data.month is string && request.resource.data.date is string
        && request.resource.data.image_id is string
        && request.resource.data.caption is string && request.resource.data.caption.size() <= 100
        && request.resource.data.thumb is string && request.resource.data.thumb.size() <= 200000
        && request.resource.data.get('people', []) is list && request.resource.data.get('people', []).size() <= 4;
      // 放照片的人和管理員可以改說明、日期、照片裡有誰；照片本身不能換
      allow update: if isFamily() && (madeIt() || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'people', 'date', 'month'])
        && request.resource.data.caption is string && request.resource.data.caption.size() <= 100
        && request.resource.data.get('people', []) is list && request.resource.data.get('people', []).size() <= 4
        && request.resource.data.date is string && request.resource.data.month is string;
      allow delete: if isFamily() && (madeIt() || isAdmin());
    }
    // 照片的愛心：每個人每張一顆（文件 id 是「照片id_自己的UID」），只能按或收回自己的
    match /photo_likes/{id} {
      allow read: if isFamily();
      allow create: if isFamily()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.photo_id is string && request.resource.data.month is string
        && id == request.resource.data.photo_id + '_' + request.auth.uid;
      // 照片改日期搬到別的月份時，底下的這一筆只能跟著改 month（要和照片的新月份一樣）
      allow update: if isFamily()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['month'])
        && request.resource.data.month == get(/databases/$(database)/documents/photos/$(resource.data.photo_id)).data.month;
      allow delete: if isFamily() && (resource.data.uid == request.auth.uid
        || !exists(/databases/$(database)/documents/photos/$(resource.data.photo_id)));
    }
    match /photo_comments/{id} {
      allow read: if isFamily();
      allow create: if isFamily()
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.author == request.auth.uid
        && request.resource.data.photo_id is string && request.resource.data.month is string
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 200;
      // 照片改日期搬到別的月份時，底下的這一筆只能跟著改 month（要和照片的新月份一樣）
      allow update: if isFamily()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['month'])
        && request.resource.data.month == get(/databases/$(database)/documents/photos/$(resource.data.photo_id)).data.month;
      // 留言只能刪自己的（管理員也一樣）。照片被刪掉之後（只有放照片的人和管理員能刪照片），
      // 底下剩下的留言誰都可以清掉，這樣刪照片時才能一併刪除留言
      allow delete: if isFamily() && (madeIt()
        || !exists(/databases/$(database)/documents/photos/$(resource.data.photo_id)));
    }

    // 視訊通話：撥打的人建立；通話裡的人（撥打的人和被邀請的人）可以加入、離開、拒絕、結束。
    // 結束後留著當作通話紀錄，撥打的人可以刪掉
    match /calls/{id} {
      allow read: if isFamily();
      allow create: if isFamily()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is list
        && request.resource.data.to.size() >= 1 && request.resource.data.to.size() <= 3
        && request.resource.data.status == 'live';
      allow update: if isFamily()
        && (resource.data.from == request.auth.uid || request.auth.uid in resource.data.to)
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to
        && request.resource.data.status in ['live', 'ended'];
      allow delete: if isFamily() && resource.data.from == request.auth.uid;
    }
    // 視訊連線用的資訊：只能以自己的名義送出；通話結束後刪掉
    match /call_signals/{id} {
      allow read: if isFamily();
      allow create: if isFamily()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.call_id is string
        && request.resource.data.to is string
        && request.resource.data.kind in ['offer', 'answer', 'cand']
        && request.resource.data.data is string && request.resource.data.data.size() <= 20000;
      allow update: if false;
      allow delete: if isFamily();
    }

    // 交通頁的常用站牌、常用車站：每個人只能讀寫自己的
    match /transit_favs/{uid} {
      allow read: if isFamily() && uid == request.auth.uid;
      allow write: if isFamily() && uid == request.auth.uid
        && request.resource.data.bus is list && request.resource.data.bus.size() <= 20
        && request.resource.data.tra is list && request.resource.data.tra.size() <= 10;
    }
    // 交通查詢的 TDX 金鑰、視訊的中繼伺服器金鑰：只有管理員能新增、查看、更換；其他家人讀不到
    // （伺服器上的雲端函式不受這裡限制，查詢時由它讀取）
    match /secrets/{id} {
      allow read, write: if isAdmin();
    }

    // 採買清單：全家都可以新增、打勾、清除
    match /shopping/{id} {
      // 日常待辦（沿用原本採買清單的資料）。全家都能新增、打勾完成；
      // 小朋友只能修改、刪除自己新增的，別人交代的只能改「完成」相關的欄位。
      function validTodo() {
        let d = request.resource.data;
        return d.text is string && d.text.size() >= 1 && d.text.size() <= 60
          && d.done is bool
          && d.get('note', '') is string && d.get('note', '').size() <= 300
          && d.get('who', '') is string && d.get('due', '') is string
          && d.get('repeat', '') in ['', 'daily', 'weekly', 'monthly']
          && d.get('star', false) is bool;
      }
      function ownTodo() {
        return !isChild() || resource.data.get('added_by', '') == request.auth.uid;
      }
      allow read: if isFamily();
      allow create: if isFamily() && validTodo()
        && request.resource.data.get('added_by', request.auth.uid) == request.auth.uid;
      allow update: if isFamily() && validTodo()
        && request.resource.data.get('added_by', '') == resource.data.get('added_by', '')
        && (ownTodo() || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['done', 'done_by', 'done_at', 'due', 'prev_due', 'last_done_by', 'last_done_at']));
      allow delete: if isFamily() && ownTodo();
    }

    // 投票：全家都看得到；只有發起人可以結束或刪除
    match /polls/{id} {
      allow read: if isFamily();
      allow create: if isFamily()
        && request.resource.data.author == request.auth.uid
        && request.resource.data.question is string
        && request.resource.data.question.size() >= 1 && request.resource.data.question.size() <= 80
        && request.resource.data.options is list
        && request.resource.data.options.size() <= 12
        && (request.resource.data.options.size() >= 2 || request.resource.data.get('open_options', false) == true)
        && request.resource.data.closed == false;
      // 發起人可以結束或作廢；其他人投票時會順手記下「已經有別人投過票」
      allow update: if isFamily() && (
        (resource.data.author == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed', 'voided'])
          && request.resource.data.closed is bool)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['others_voted'])
          && request.resource.data.others_voted == true)
        // 開放加選項的投票：進行中任何家人都可以在最後面加一個選項，原本的選項不能動
        || (resource.data.get('open_options', false) == true
          && resource.data.closed == false && resource.data.get('voided', false) == false
          && (resource.data.get('deadline_at', 0) == 0 || request.time.toMillis() <= resource.data.get('deadline_at', 0))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['options', 'option_by'])
          && request.resource.data.options is list
          && request.resource.data.options.size() == resource.data.options.size() + 1
          && request.resource.data.options.size() <= 12
          && request.resource.data.options[0:resource.data.options.size()] == resource.data.options
          && request.resource.data.options[resource.data.options.size()] is string
          && request.resource.data.options[resource.data.options.size()].size() >= 1
          && request.resource.data.options[resource.data.options.size()].size() <= 30
          && request.resource.data.get('option_by', {}) is map)
      );
      // 只有還沒有其他人投票的投票可以刪除；有人投過就只能作廢
      allow delete: if isFamily() && resource.data.author == request.auth.uid
        && resource.data.get('others_voted', false) == false;
    }

    // 每人每個投票一票（文件 ID = 投票id_自己的UID），可以改選；投票結束後不能再投
    match /poll_votes/{voteId} {
      allow read: if isFamily();
      allow create, update: if isFamily()
        && request.resource.data.uid == request.auth.uid
        && voteId == request.resource.data.poll_id + '_' + request.auth.uid
        && request.resource.data.choice is int
        && request.resource.data.choice >= 0 && request.resource.data.choice < 12
        && pollOpen(request.resource.data.poll_id);
      allow delete: if false;
    }

    // 資料卡：全家都能看，只有家長能新增、修改、刪除
    // 資料卡：家長看得到、改得了全部；小朋友只能看、改、刪自己新增的（家長新增的看不到）
    match /cards/{id} {
      function validCard() {
        return request.resource.data.title is string
          && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 40
          && request.resource.data.body is string && request.resource.data.body.size() <= 2000;
      }
      allow read: if isFamily() && (!isChild() || resource.data.created_by == request.auth.uid);
      allow create: if isFamily() && validCard()
        && request.resource.data.created_by == request.auth.uid
        && (!isChild() || request.resource.data.member == request.auth.uid);
      allow update: if isFamily() && validCard()
        && request.resource.data.get('created_by', null) == resource.data.get('created_by', null)
        && (!isChild() || (resource.data.created_by == request.auth.uid && request.resource.data.member == request.auth.uid));
      allow delete: if isFamily() && (!isChild() || resource.data.created_by == request.auth.uid);
    }

    // 我有話要說：全家都看得到，只有發言的人可以刪除
    match /posts/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && validPost();
      allow delete: if isFamily() && resource.data.author == request.auth.uid;
      allow update: if false;
    }
    match /replies/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && validReply();
      allow update, delete: if false;
    }

    // 成員基本資料：每個人只能改自己的；管理員可以改所有人的。
    // 管理員 = members 文件裡有 admin: true 的成員（只能在 Firebase 後台設定）。
    match /profiles/{uid} {
      allow read: if isFamily();
      allow write: if isFamily()
        && exists(/databases/$(database)/documents/members/$(uid))
        && (uid == request.auth.uid || isAdmin());
    }

    // 推播用的裝置代碼：只能登記在自己名下，App 讀不到（只有伺服器端程式會讀）
    match /push_tokens/{token} {
      allow read: if false;
      allow create, update: if isFamily() && request.resource.data.uid == request.auth.uid;
      allow delete: if isFamily() && resource.data.uid == request.auth.uid;
    }

    // 上線狀態：每個人只能更新自己的
    match /presence/{uid} {
      allow read: if isFamily();
      allow write: if isFamily() && uid == request.auth.uid;
    }
  }
}
